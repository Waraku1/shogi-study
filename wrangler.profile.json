{
  "name": "shogi-study-local-profile",
  "main": "server/profile-worker.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": { "APP_ORIGIN": "http://localhost:5173" },
